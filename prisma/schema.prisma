generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  role         String
  firstname    String
  lastname     String
  fullname     String
  phone        String    @unique
  password     String
  refreshToken String
  isBan        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userInfo     UserInfo?
}

model UserInfo {
  id         String   @id @default(uuid())
  userId     String   @unique
  address    String
  city       String
  province   String
  postalCode String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RateLimit {
  id        String   @id @default(uuid())
  key       String  
  phone     String
  count     Int      @default(1)
  expiresAt DateTime 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([phone, key])
  @@index([expiresAt])
}

