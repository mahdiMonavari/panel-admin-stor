generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Otp {
  id        String   @id @default(uuid())
  phone     String 
  code      String  
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([phone])
}


model User {
  id           String    @id @default(uuid())
  role         String
  firstname    String
  lastname     String
  fullname     String
  phone        String    @unique
  password     String
  refreshToken String
  isBan        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userInfo     UserInfo?
}

model UserInfo {
  id         String   @id @default(uuid())
  userId     String   @unique
  address    String
  city       String
  province   String
  postalCode String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RateLimit {
  id        String   @id @default(uuid())
  key       String  
  phone     String
  count     Int      @default(1)
  expiresAt DateTime 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([phone, key])
  @@index([expiresAt])
}

// ---------- دسته‌بندی ----------
model Category {
  id         String   @id @default(uuid())
  name       String
  parentId   String?
  parent     Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]
}

// ---------- ویژگی ----------
model Attribute {
  id        String   @id @default(uuid())
  name      String
  type      String
  label     String
  values    AttributeValue[]
  categories CategoryAttribute[]

  productStaticAttributes ProductStaticAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([name, type])
}

// ---------- مقدار ویژگی ----------
model AttributeValue {
  id          String   @id @default(uuid())
  value       String
  label       String
  attributeId String
  code        String?
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variantValues    ProductVariantAttributeValue[]  

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([attributeId, value])
}

// ---------- اتصال دسته-ویژگی ----------
model CategoryAttribute {
  categoryId  String
  attributeId String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@id([categoryId, attributeId])
}

// ---------- محصول ----------
model Product {
  id                 String       @id @default(uuid())
  name               String
  description        String
  categoryId         String
  totalStock         Int          @default(0)
  minPrice           Decimal?
  maxPrice           Decimal?
  category           Category     @relation(fields: [categoryId], references: [id])
  isActive           Boolean      @default(false)
  infoId             String?      @unique
  info               ProductInfo? @relation(fields: [infoId], references: [id], onDelete: Cascade)
  
  variants           ProductVariant[]
  staticAttributes   ProductStaticAttribute[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ---------- اطلاعات تکمیلی محصول ----------
model ProductInfo {
  id      String  @id @default(uuid())
  data    Json
  product Product?
}

// ---------- ورینت محصول ----------
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  signature       String
  isActive        Boolean @default(false)
  deletedAt       DateTime?
  discountPercent Decimal?
  price           Decimal?
  stock           Int?
  values          ProductVariantAttributeValue[]

  @@unique([productId, signature])
  @@index([productId, isActive])
}


// ---------- ویژگی ثابت محصول ----------
model ProductStaticAttribute {
  id               String @id @default(uuid())
  productId        String
  attributeId      String  
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id])
  value String?

  @@unique([productId, attributeId])
}

// ---------- مقدارِ ویژگیِ متغیرِ ورینت ----------
model ProductVariantAttributeValue {
  productVariantId String
  attributeValueId String

  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([productVariantId, attributeValueId])
}
